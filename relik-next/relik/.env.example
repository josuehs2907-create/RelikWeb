# Copia este archivo como ".env.local" y completa los valores desde Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca la subas a GitHub ni la uses en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Id del taller (tabla tenants). Mientras haya un solo taller, las rutas publicas usan este valor.
DEFAULT_TENANT_ID=
